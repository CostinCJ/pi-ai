# Required secrets
GROQ_API_KEY=
TELEGRAM_TOKEN=
CHAT_ID=
OWM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional / has defaults
GROQ_MODEL=llama-3.3-70b-versatile
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
LAPTOP_MAC=AA-BB-CC-DD-EE-FF
PHONE_MAC=aa:bb:cc:dd:ee:ff
TAILSCALE_IP=100.64.0.1
SESSION_SERVER_PORT=8765
SESSION_SHARED_SECRET=
LAPTOP_TAILSCALE_IP=
SHUTDOWN_PORT=8766

# Schedule anchor (ISO date of any săpt-1 Monday)
SAPT1_ANCHOR=2026-04-27

# Tunables (override only if you know why)
HEARTBEAT_INTERVAL_MIN=10
PRESENCE_INTERVAL_MIN=2
QUIET_HOURS_START=2
QUIET_HOURS_END=9
RECENT_ACTIVE_COOLDOWN_MIN=90
AWAY_THRESHOLD_MIN=25
AWAY_DEBOUNCE_SCANS=3
SESSION_STALE_SEC=300
SESSION_KEEP_ROWS=50
ECHO_OVERLAP_THRESHOLD=0.6
ECHO_MIN_USER_WORDS=5
PATTERN_TRIGGER_PROBABILITY=0.30
IN_CHARACTER_MAX_CHARS=220
IN_CHARACTER_MAX_CHARS_LONG=500
LONG_USER_MESSAGE_THRESHOLD=40
LLM_LOG_MAX_BYTES=5242880
APP_LOG_MAX_BYTES=2097152
APP_LOG_BACKUPS=3
PATTERN_LOG_MAX_ROWS=500
WEEKLY_PROFILE_MAX_ROWS=26
FACT_DECAY_DAYS=30
FACT_DECAY_FLOOR=0.2
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
SEARCH_MAX_RESULTS=3

# Riot Games API — post_game trigger + in-game proactive suppression stay
# dormant until these are set. Get a key at https://developer.riotgames.com
RIOT_API_KEY=
RIOT_PUUID=
RIOT_REGION=europe
RIOT_PLATFORM=eun1

# Semester date ranges (start:end, comma-separated) — update each semester,
# outside them class_soon never fires. See config.py SEMESTER_RANGES.
# SEMESTER_RANGES=2026-02-23:2026-06-07,2026-09-28:2026-12-20
